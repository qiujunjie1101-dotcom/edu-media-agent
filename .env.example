# ============================================================================
# 环境变量模板
# ============================================================================
# 使用方式：
#   1. 复制本文件为 .env ：cp .env.example .env
#   2. 按需修改 .env 中的值（.env 已被 .gitignore 忽略，不会被提交到仓库）
#   3. 代码中通过 app/core/config.py 的 Settings 类读取，业务代码不直接读 os.environ
#
# 重要：
#   - 本文件只放「字段名 + 示例值」，禁止写入任何真实密钥
#   - S1 阶段全部使用 Mock 服务，不需要任何密钥，也不需要数据库
# ============================================================================

# ---------- 应用基础信息 ----------
# 应用名称，会出现在 /health 响应与 FastAPI 文档标题中
APP_NAME="自媒体内容运营 AI 智能体"
# 运行环境标识，常用取值：local（本地）/ test（测试）/ prod（生产）
APP_ENV=local

# ---------- AI 服务提供方 ----------
# 文本模型提供方。S1 阶段仅支持 mock（确定性假数据，不联网）
LLM_PROVIDER=mock
# 图片模型提供方。S1 阶段仅支持 mock（返回稳定的模拟图片地址）
IMAGE_PROVIDER=mock

# ---------- 业务参数 ----------
# 文章最多允许被人工驳回重写的次数（达到上限后只能人工通过）
MAX_REVISIONS=3

# ---------- 跨源访问（S4 前端联调） ----------
# 允许调用本服务的前端来源，多个用英文逗号分隔（例如：http://localhost:5173,http://127.0.0.1:5173）
# 默认只放行 Vite 开发服务器 http://localhost:5173；留空表示完全不启用跨源访问
# 注意：不要填 *，本服务允许携带凭证，浏览器禁止两者同时使用
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- 检查点存储（S5） ----------
# 工作流的会话状态存在哪里：
#   memory   —— 存在进程内存里，重启即丢。本地开发和跑测试用这个，不需要数据库。
#   postgres —— 存进 PostgreSQL，重启后凭 thread_id 仍能恢复现场。默认值就是 memory。
CHECKPOINTER_BACKEND=memory

# 仅 checkpointer_backend=postgres 时必填；选了 postgres 却不填，服务会拒绝启动。
# 连接池大小：min 是启动时立即建立的连接数（配大会拖慢启动），
# max 是并发上限（超过的请求会在池上排队）。
# POSTGRES_URI=postgresql://langgraph:改成你的口令@localhost:5432/langgraph_db
# POSTGRES_POOL_MIN_SIZE=1
# POSTGRES_POOL_MAX_SIZE=10
#
# 注意：
#   1. 上面那行口令只是占位符，**请勿把真实口令写进本文件**——它是模板，会进仓库。
#      真实口令填在 .env 里（.env 已被 .gitignore 忽略）。
#   2. 本服务的日志与错误信息只会输出脱敏后的连接串（口令显示为 ***）。

# ============================================================================
# 以下变量属于后续阶段，请保持注释状态（代码尚未读取它们）
# ============================================================================
# 【S7 真实文本模型】
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# 【S8 真实图片模型】
# IMAGE_API_KEY=xxxxxxxxxxxxxxxx
# IMAGE_BASE_URL=https://api.example.com/v1
